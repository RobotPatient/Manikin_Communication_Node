/ {
    aliases {
            led0 = &red_led;
            sw0 = &mybutton0;  // Link sw0 alias to your button
    };

    keys {
        compatible = "gpio-keys";

        mybutton0: button_0 {
            label = "User Button";
            gpios = <&gpioc 13 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
        };
    };
};