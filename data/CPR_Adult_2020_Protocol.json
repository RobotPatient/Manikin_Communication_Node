{
  "guideline_name": "AHA 2020 Adult CPR",
  "version": "v1.0.0",
  "compression": {
    "target_depth_min_mm": 50,
    "target_depth_max_mm": 60,
    "target_rate_min_bpm": 100,
    "target_rate_max_bpm": 120,
    "recoil_threshold_percent": 90, // Percentage of full release to consider recoil complete
    "low_depth_threshold_mm": 45,
    "high_depth_threshold_mm": 65,
    "low_rate_threshold_bpm": 90,
    "high_rate_threshold_bpm": 130
  },
  "ventilation": {
    "target_volume_ml": 500,
    "target_duration_sec": 1,
    "low_volume_threshold_ml": 400,
    "high_volume_threshold_ml": 600,
    "low_duration_threshold_sec": 0.8,
    "high_duration_threshold_sec": 1.2
  },
  "hand_position": {
    "acceptable_pressure_deviation_percent": 20 // Example: Allowable deviation from ideal pressure distribution
  },
  "head_position": {
    "min_tilt_angle_degrees": 15, // Example: Minimum head tilt angle for adequate airway
    "max_backward_extension_degrees": 30 // Example: Maximum backward extension angle
  },
  "feedback_settings": {
    "rate_calculation_window_ms": 2000, // Time window to calculate compression rate
    "depth_averaging_window_ms": 500    // Time window to average depth for stability
  }
}
