# Configuration with Bluetooth enabled

# Basic peripherals
CONFIG_GPIO=y

# Core features
CONFIG_CLOCK_CONTROL=y

# Enable Zephyr CRC library
CONFIG_CRC=y

# Bluetooth configuration
CONFIG_BT=y
CONFIG_BT_PERIPHERAL=y
CONFIG_BT_DEVICE_NAME="ManikinTest"
CONFIG_BT_RX_STACK_SIZE=4096

# Increase BLE buffer sizes to handle larger payloads
CONFIG_BT_BUF_ACL_RX_SIZE=251
CONFIG_BT_BUF_ACL_TX_SIZE=251
CONFIG_BT_L2CAP_TX_BUF_COUNT=20
CONFIG_BT_CONN_TX_MAX=20
CONFIG_BT_ATT_PREPARE_COUNT=10

# BLE controller configuration - ONLY enable these if your board has a built-in controller
# If you're using an external BLE module via UART, comment these out
CONFIG_BT_LL_SW_SPLIT=y                 # Enable Zephyr BLE controller
CONFIG_BT_CTLR=y                        # Enable controller
CONFIG_BT_CTLR_DATA_LENGTH=y            # Enable data length extension
CONFIG_BT_CTLR_DATA_LENGTH_MAX=251      # Maximum PDU size
CONFIG_BT_CTLR_TX_BUFFERS=10            # Number of TX buffers
CONFIG_BT_CTLR_RX_BUFFERS=10            # Number of RX buffers

# To use an external controller via UART instead, comment out the above 
# controller section and uncomment these:
# CONFIG_BT_HCI=y
# CONFIG_BT_HCI_TRANSPORT_UART=y
# CONFIG_BT_UART_ON_DEV_NAME="UART_1"

# Notification queue and prioritization
CONFIG_HEAP_MEM_POOL_SIZE=16384
CONFIG_SYSTEM_WORKQUEUE_STACK_SIZE=2048

# Logging configuration
CONFIG_LOG=y
CONFIG_LOG_MAX_LEVEL=4
CONFIG_LOG_MODE_IMMEDIATE=y 
CONFIG_USE_SEGGER_RTT=y
CONFIG_LOG_BACKEND_RTT=y

# Stack sizes
CONFIG_MAIN_STACK_SIZE=2048
CONFIG_ISR_STACK_SIZE=2048

# Console configuration
CONFIG_RTT_CONSOLE=y
CONFIG_LOG_BACKEND_UART=n
CONFIG_UART_CONSOLE=n

# Watchdog for reliability
CONFIG_WATCHDOG=y

# Other manikin settings
CONFIG_CPR_MANIKIN_BLE_NOTIFICATION_QUEUE_SIZE=64
CONFIG_CPR_MANIKIN_MAX_NOTIFICATION_RETRY=5