mainmenu "CPR Manikin BLE Configuration"

menu "CPR Manikin Application"

config CPR_MANIKIN_BLE_NOTIFICATION_QUEUE_SIZE
	int "Size of BLE notification message queue"
	default 64
	help
	  Maximum number of notifications that can be queued for sending.
	  Increasing this value will allow more notifications to be buffered
	  before dropping or blocking.

config CPR_MANIKIN_MAX_NOTIFICATION_RETRY
	int "Maximum notification retry attempts"
	default 5
	help
	  Maximum number of times to retry sending a notification
	  that failed due to memory errors.

config CPR_MANIKIN_PRIORITY_HIGH_THRESHOLD
	int "Priority threshold for high priority messages"
	default 80
	help
	  Priority value threshold for high priority messages (0-100).
	  Messages with priority >= this value are considered high priority.

config CPR_MANIKIN_PRIORITY_MEDIUM_THRESHOLD
	int "Priority threshold for medium priority messages"
	default 50
	help
	  Priority value threshold for medium priority messages (0-100).
	  Messages with priority >= this value are considered medium priority.

endmenu

source "Kconfig.zephyr"